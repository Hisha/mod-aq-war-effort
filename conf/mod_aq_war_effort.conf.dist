[worldserver]

########################################
# mod-aq-war-effort configuration
########################################
#
#    AQWarEffort.Enable
#        Description: Enables contribution tracking, collection event 22 control and quartermaster reports (restart required)
#        Default:     0 - Disabled
#                     1 - Enabled
#

AQWarEffort.Enable = 1

#
#    AQWarEffort.Id
#        Description: Campaign ID. Each ID has independent persistent totals/state (restart required).
#        Default:     1
#

AQWarEffort.Id = 1

#
#    AQWarEffort.Goal.Faction.XXX
#        Description: Per-material goals: .01, .02 and .03 select the three materials in each category.
#                     These are item quantities, NOT visual progression stages.
#

AQWarEffort.Goal.Horde.Bandages.01 = 2000
AQWarEffort.Goal.Horde.Bandages.02 = 4000
AQWarEffort.Goal.Horde.Bandages.03 = 6000
AQWarEffort.Goal.Horde.Food.01 = 2000
AQWarEffort.Goal.Horde.Food.02 = 4000
AQWarEffort.Goal.Horde.Food.03 = 6000
AQWarEffort.Goal.Horde.Herbs.01 = 2000
AQWarEffort.Goal.Horde.Herbs.02 = 4000
AQWarEffort.Goal.Horde.Herbs.03 = 6000
AQWarEffort.Goal.Horde.Metal.01 = 2000
AQWarEffort.Goal.Horde.Metal.02 = 4000
AQWarEffort.Goal.Horde.Metal.03 = 6000
AQWarEffort.Goal.Horde.Leather.01 = 1000
AQWarEffort.Goal.Horde.Leather.02 = 2000
AQWarEffort.Goal.Horde.Leather.03 = 3000

AQWarEffort.Goal.Alliance.Bandages.01 = 2000
AQWarEffort.Goal.Alliance.Bandages.02 = 4000
AQWarEffort.Goal.Alliance.Bandages.03 = 6000
AQWarEffort.Goal.Alliance.Food.01 = 2000
AQWarEffort.Goal.Alliance.Food.02 = 4000
AQWarEffort.Goal.Alliance.Food.03 = 6000
AQWarEffort.Goal.Alliance.Herbs.01 = 2000
AQWarEffort.Goal.Alliance.Herbs.02 = 4000
AQWarEffort.Goal.Alliance.Herbs.03 = 6000
AQWarEffort.Goal.Alliance.Metal.01 = 2000
AQWarEffort.Goal.Alliance.Metal.02 = 4000
AQWarEffort.Goal.Alliance.Metal.03 = 6000
AQWarEffort.Goal.Alliance.Leather.01 = 1000
AQWarEffort.Goal.Alliance.Leather.02 = 2000
AQWarEffort.Goal.Alliance.Leather.03 = 3000

# Settings other than TenHourWar.Duration require restart after editing.
# Each goal must be at least one full turn-in and an exact multiple of its quantity.
# Defaults are one/two/three turn-ins: 20/40/60 items, or 10/20/30 for leather.
# Invalid goals stop tracking and collection event 22 until corrected and restarted.
# Configure production goals before enabling. Only WAR_EFFORT accepts contributions.

# Real seconds from the persisted current gong/administrative war start.
# Reloadable with .reload config. Changes apply to the ORIGINAL start, not reload time;
# shortening can immediately expire an active war. Offline time counts too.
# Valid integers: 1..4294967295. Invalid values disable automatic expiration only.
# Default: 36000 (10 hours). For development: 300 (5 minutes).
AQWarEffort.TenHourWar.Duration = 36000
